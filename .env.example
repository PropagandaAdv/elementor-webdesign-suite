# Copia questo file in .env (già in .gitignore, non finirà mai nel commit) e
# compila i valori reali del tuo ambiente WordPress. Non scrivere MAI questi
# valori direttamente nei file della skill o del plugin.

# --- Canale A: SSH + WP-CLI ---
WP_SSH_HOST=user@staging.example.com
WP_PATH=/var/www/staging.example.com

# --- Canale B: REST API + Application Password ---
WP_URL=https://staging.example.com
WP_USER=claude
WP_APP_PASSWORD=

# --- Canale B0: MCP server WordPress opzionale (es. Royal MCP o equivalente) ---
WP_MCP_URL=https://staging.example.com/wp-json/royal-mcp/v1/mcp
WP_MCP_TOKEN=

# --- Connettori di generazione immagini/video (se usati) ---
# Configura i rispettivi MCP server in .mcp.json e le chiavi qui, se richiesto
# dal provider scelto (Magnific, Kling, Higgsfield, o altro).
